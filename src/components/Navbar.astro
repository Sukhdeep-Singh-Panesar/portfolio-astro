---

---
<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl ">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">

    <a href="/" class="text-xl font-bold tracking-tight">
        Sukhdeep<span class="text-indigo-400">.</span>
    </a>
        <!-- Desktop navigation -->
        <nav
                aria-label="Desktop navigation"
                class="hidden items-center gap-8 md:flex"
        >

            <a
                    href="#projects"
                    class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
            >
                Projects
            </a>

            <a href="#about"     class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
            >
                About
            </a>

            <a
                    href="#skills"
                    class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
            >
                Skills
            </a>

            <a
                    href="#contact"
                    class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
            >
                Contact
            </a>

            <a
                    href="https://github.com/Sukhdeep-Singh-Panesar"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium transition-colors hover:border-indigo-400 hover:text-indigo-400"
            >
                View GitHub
                <img
                        src="/icons/up-right-arrow.svg"
                        alt=""
                        class="h-4 w-4"
                />
            </a>
        </nav>

        <!-- Mobile navigation -->
        <details class="relative md:hidden">
            <summary
                    class="flex cursor-pointer list-none items-center rounded-lg border border-slate-700 p-3"
            >
                <span class="sr-only">Open navigation menu</span>
                <img
                        src="/icons/menu.svg"
                        alt=""
                        class="h-5 w-5"
                />
            </summary>

            <nav
                    aria-label="Mobile navigation"
                    class="absolute right-0 top-full mt-3 flex w-52 flex-col gap-4 rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-xl"
            >
                <a
                        href="#projects"
                        class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
                >
                    Projects
                </a>

                <a
                        href="#about"
                        class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
                >
                    About
                </a>

                <a
                        href="#skills"
                        class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
                >
                    Skills
                </a>


                <a
                        href="#contact"
                        class="text-sm font-medium text-slate-300 transition-colors hover:text-indigo-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
                >
                    Contact
                </a>

                <a
                        href="https://github.com/Sukhdeep-Singh-Panesar"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm font-medium text-slate-300 hover:text-indigo-400"
                >
                    View GitHub
                </a>
            </nav>
        </details>
    </div>
</header>
