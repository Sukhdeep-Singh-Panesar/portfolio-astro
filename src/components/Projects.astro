---
import ProjectCard from './ProjectCard.astro';
const projects = [
    {
        title: "TaskHub",
        description: "A responsive task management application featuring task filtering, persistent browser storage, and real-time progress tracking.",
        image: "/images/taskhub-dashboard.png",
        technologies: ["React", "TypeScript", "Tailwind CSS", "Vite"],
        githubUrl: "https://github.com/Sukhdeep-Singh-Panesar/TaskHub",
        liveUrl: "https://to-do-list-app-rust-five.vercel.app/",
        status: "completed" as const,
        priority: 1
    },
    {
        title: "PChat",
        description: "A messaging platform under development using Next.js, NestJS, TypeScript, and PostgreSQL.",
        image: "/images/pchat-preview.svg",
        technologies: ["Next.js", "NestJS", "TypeScript", "PostgreSQL"],
        githubUrl: "https://github.com/Sukhdeep-Singh-Panesar/pchat",
        liveUrl: "",
        status: "in-development" as const,
        priority: 2
    }
];

const sortedProjects = [...projects].sort(
    (a, b) => {
        if (a.status === "completed" && b.status === "in-development") {
            return -1;
        }
        if (a.status === "in-development" && b.status === "completed") {
            return 1;
        }
        return a.priority - b.priority;
    });

---
<section id="projects" class="scroll-mt-24 mx-auto max-w-6xl px-6 py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-400">
        Selected Work
    </p>

    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Projects I've Built
    </h2>

    <div class="mt-12 grid gap-8">
        {sortedProjects.map((project) => (
            <ProjectCard
                title={project.title}
                description={project.description}
                image={project.image}
                technologies={project.technologies}
                githubUrl={project.githubUrl}
                liveUrl={project.liveUrl}
                status={project.status}
            />
        ))
        }
    </div>

</section>