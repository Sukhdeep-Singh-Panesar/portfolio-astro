---

---
<section class="relative overflow-hidden border-b border-slate-800">

    <div class="pointer-events-none absolute right-0 top-0 h-96 w-96 rounded-full bg-indigo-500/10 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-6xl gap-10 px-6 py-12 sm:py-16 lg:min-h-[calc(100svh-72px)] lg:grid-cols-2 lg:items-center lg:gap-12 lg:py-10">
        <div>
            <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-indigo-400">
                Applied Computer Science · Software Development
            </p>

            <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
                <span class="block text-white">
                   Building Software
                </span>
                <span class="mt-3 block bg-linear-to-r from-indigo-400 via-violet-400 to-cyan-300 bg-clip-text text-transparent">
                    That Solves Real Problems.
                </span>
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-400">
                I'm Sukhdeep Singh Panesar, an Applied Computer Science student
                passionate about developing modern web applications,
                solving problems, and continuously improving my engineering skills.
            </p>

            <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">

                <a
                        href="#projects"
                        class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-950/40 transition-all duration-300 hover:-translate-y-1 hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
                >
                    View My Projects
                </a>

                <a href="https://github.com/Sukhdeep-Singh-Panesar"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/60 px-7 py-3.5 text-sm font-semibold text-slate-200 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-400/60 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"                >
                    GitHub <img
                        src="/icons/up-right-arrow.svg"
                        alt=""
                        aria-hidden="true"
                        class="h-4 w-4"
                />
                </a>
            </div>
        </div>

        <div class="group rounded-3xl border border-white/10 bg-slate-900/70 p-4 shadow-2xl shadow-indigo-950/30 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-400/40 sm:p-6">
            <div class="mb-6 flex items-center justify-between">
                <p class="font-semibold text-white">Featured Work</p>
                <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400">
                    Completed
                </span>
            </div>

            <div class="overflow-hidden rounded-xl border border-slate-700 bg-slate-950">

                    <!-- Browser-style title bar -->
                    <div class="flex items-center gap-2 border-b border-slate-800 px-4 py-3">
                        <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>

                        <span class="ml-3 text-xs text-slate-400">
            TaskHub — Dashboard Preview
        </span>
                    </div>

                    <!-- Real project screenshot -->
                    <img
                            src="/images/taskhub-dashboard.png"
                            alt="TaskHub dashboard displaying tasks, statistics, and progress"
                            class="block w-full"
                    />

                    <!-- Project information -->
                    <div class="p-5">
                        <p class="mb-2 text-xs font-medium uppercase tracking-widest text-indigo-400">
                            Featured Project / 01
                        </p>

                        <h2 class="text-2xl font-bold text-white">
                            TaskHub
                        </h2>

                        <p class="mt-3 text-sm leading-6 text-slate-400">
                            A responsive task management dashboard with filtering,
                            persistent storage, and progress tracking.
                        </p>

                        <div class="mt-5 flex flex-wrap gap-2">
                            <span class="rounded-md bg-slate-800 px-3 py-1.5 text-xs text-slate-300">React</span>
                            <span class="rounded-md bg-slate-800 px-3 py-1.5 text-xs text-slate-300">TypeScript</span>
                            <span class="rounded-md bg-slate-800 px-3 py-1.5 text-xs text-slate-300">Tailwind</span>
                        </div>
                        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">

                            <a
                                    href="https://to-do-list-app-rust-five.vercel.app/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors duration-300 hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"                        >
                                Live Demo <img
                                    src="/icons/up-right-arrow.svg"
                                    alt=""
                                    aria-hidden="true"
                                    class="h-4 w-4"
                            />
                            </a>

                            <a
                                href="https://github.com/Sukhdeep-Singh-Panesar/TaskHub"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"                        >
                            View Source Code
                            <img
                                    src="/icons/up-right-arrow.svg"
                                    alt=""
                                    aria-hidden="true"
                                    class="h-4 w-4"
                            />
                        </a>

                        </div>
                    </div>
            </div>
        </div>

    </div>
</section>
