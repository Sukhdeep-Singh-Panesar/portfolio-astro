---

---
<section class="relative overflow-hidden border-b border-slate-800">

    <div class="pointer-events-none absolute right-0 top-0 h-96 w-96 rounded-full bg-indigo-500/10 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:min-h-140 lg:grid-cols-2 lg:items-center lg:py-20">
        <div>
            <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-indigo-400">
                Applied Computer Science · Software Development
            </p>

            <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
                <span class="block text-white">
                   Building Software
                </span>
                <span class="mt-3 block bg-linear-to-r from-indigo-400 via-violet-400 to-cyan-300 bg-clip-text text-transparent">
                    That Solves Real Problems.
                </span>
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-400">
                I'm Sukhdeep Singh Panesar, an Applied Computer Science student
                passionate about developing modern web applications,
                solving problems, and continuously improving my engineering skills.
            </p>

            <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">

                <a
                        href="#projects"
                        class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-950/40 transition-all duration-300 hover:-translate-y-1 hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"
                >
                    View My Projects
                </a>

                <a href="https://github.com/Sukhdeep-Singh-Panesar"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/60 px-7 py-3.5 text-sm font-semibold text-slate-200 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-400/60 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"                >
                    GitHub <img
                        src="/icons/up-right-arrow.svg"
                        alt=""
                        aria-hidden="true"
                        class="h-4 w-4"
                />
                </a>
            </div>
        </div>

        <div class="relative hidden lg:block" aria-hidden="true">

            <!-- Background glow -->
            <div class="pointer-events-none absolute inset-6 rounded-full bg-indigo-500/25 blur-3xl"></div>

            <!-- Floating browser window -->
            <div class="relative translate-x-6 -rotate-3 overflow-hidden rounded-2xl border border-indigo-400/40 bg-slate-900 shadow-2xl shadow-indigo-950/60 transition-transform duration-300 hover:-rotate-1">

                <!-- Browser title bar -->
                <div class="flex items-center gap-2 border-b border-white/10 bg-slate-950 px-4 py-3">
                    <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>

                    <span class="ml-3 text-xs text-slate-400">
                TaskHub — Dashboard Preview
            </span>
                </div>

                <!-- Actual TaskHub screenshot -->
                <img
                        src="/images/taskhub-dashboard.png"
                        alt=""
                        class="block w-full"
                />

            </div>
        </div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 pb-16 lg:pb-24">
        <div class="group grid overflow-hidden rounded-3xl border border-white/10 bg-slate-900/70 shadow-2xl shadow-indigo-950/30 transition-colors duration-300 hover:border-indigo-400/40 lg:grid-cols-2">

            <!-- Left: TaskHub Screenshot -->
            <div class="flex items-center bg-slate-950 p-5 sm:p-8">
                <div class="w-full overflow-hidden rounded-xl border border-slate-700 bg-slate-900">

                    <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
                        <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>

                        <span class="ml-3 text-xs text-slate-400">
                    TaskHub — Dashboard
                </span>
                    </div>

                    <img
                            src="/images/taskhub-dashboard.png"
                            alt="TaskHub task management dashboard"
                            loading="lazy"
                            class="max-h-80 w-full object-contain"
                    />
                </div>
            </div>

            <!-- Right: Project Details -->
            <div class="flex flex-col justify-center p-6 sm:p-10">

                <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-indigo-400">
                    Featured Work / 01
                </p>

                <h2 class="text-3xl font-bold tracking-tight text-white">
                    TaskHub
                </h2>

                <p class="mt-4 max-w-lg text-base leading-7 text-slate-400">
                    A responsive task management dashboard with filtering,
                    persistent storage, and progress tracking.
                </p>

                <div class="mt-6 flex flex-wrap gap-2">
                    <span class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs text-slate-300">React</span>
                    <span class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs text-slate-300">TypeScript</span>
                    <span class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs text-slate-300">Tailwind CSS</span>
                </div>

                <div class="mt-8 flex flex-wrap items-center gap-5">

                    <a
                            href="https://to-do-list-app-rust-five.vercel.app/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
                    >
                        Live Demo <img
                                    src="/icons/up-right-arrow.svg"
                                    alt=""
                                    aria-hidden="true"
                                    class="h-4 w-4"
                            />
                            </a>

                            <a
                                href="https://github.com/Sukhdeep-Singh-Panesar/TaskHub"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-400"                        >
                            View Source Code
                            <img
                                    src="/icons/up-right-arrow.svg"
                                    alt=""
                                    aria-hidden="true"
                                    class="h-4 w-4"
                            />
                        </a>

                        </div>
                    </div>
            </div>
        </div>

</section>
