---

---
<section class="relative overflow-hidden border-b border-slate-800">

    <div class="pointer-events-none absolute right-0 top-0 h-96 w-96 rounded-full bg-indigo-500/10 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-6xl gap-12 px-6 py-24 lg:grid-cols-2 lg:items-center lg:py-32">

        <div>
            <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-indigo-400">
                Applied Computer Science · Software Development
            </p>

            <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
                Building software
                <span class="bg-linear-to-r from-indigo-400 to-cyan-300 bg-clip-text text-transparent">
                    that makes a difference.
                </span>
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-400">
                I'm Sukhdeep Singh Panesar, an Applied Computer Science student
                passionate about developing modern web applications,
                solving problems, and continuously improving my engineering skills.
            </p>

            <div class="mt-9 flex flex-wrap gap-4">
                <a href="#projects"
                   class="rounded-xl bg-indigo-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-indigo-500">
                    Explore My Projects
                </a>

                <a href="https://github.com/Sukhdeep-Singh-Panesar"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="rounded-xl border border-slate-700 px-6 py-3 font-semibold transition-colors hover:border-indigo-400 hover:text-indigo-400">
                    GitHub ↗
                </a>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-700 bg-slate-900/80 p-6 shadow-2xl shadow-indigo-950/30">
            <div class="mb-6 flex items-center justify-between">
                <p class="font-semibold text-white">Featured Work</p>
                <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400">
                    Completed
                </span>
            </div>

            <div class="rounded-xl border border-slate-700 bg-slate-950 p-6">
                <p class="mb-3 text-sm text-indigo-400">01 / PROJECT</p>

                <h2 class="text-2xl font-bold">TaskHub</h2>

                <p class="mt-3 leading-7 text-slate-400">
                    A responsive task management dashboard with filtering,
                    persistent storage, and progress tracking.
                </p>

                <div class="mt-5 flex flex-wrap gap-2 text-xs text-slate-300">
                    <span class="rounded-lg bg-slate-800 px-3 py-2">React</span>
                    <span class="rounded-lg bg-slate-800 px-3 py-2">TypeScript</span>
                    <span class="rounded-lg bg-slate-800 px-3 py-2">Tailwind CSS</span>
                </div>

                <a href="https://github.com/Sukhdeep-Singh-Panesar/TaskHub"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="mt-6 inline-block text-sm font-semibold text-indigo-400 hover:text-indigo-300">
                    View Project ↗
                </a>
            </div>
        </div>

    </div>
</section>
