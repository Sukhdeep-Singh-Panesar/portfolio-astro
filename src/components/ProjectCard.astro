---
interface Props {
    title: string;
    description: string;
    technologies: string[];
    image?: string;
    imageAlt?: string;
    githubUrl?: string;
    liveUrl?: string;
    status: "completed" | "in-development";
}

const {
    title,
    description,
    image,
    technologies,
    githubUrl,
    liveUrl,
    status,
    imageAlt
} = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-slate-900/70 transition-colors duration-300 hover:border-indigo-400/40">
    <!-- Project screenshot -->
    <div class="flex aspect-[16/10] w-full items-center overflow-hidden bg-slate-950 p-4 sm:p-5">
        {image ? (
                <img
                        src={image}
                        alt={imageAlt ?? `${title} project preview`}
                        loading="lazy"
                        class="h-full w-full rounded-xl border border-white/10 object-contain shadow-2xl"
                />
        ) : (
                <div class="flex h-full w-full flex-col items-center justify-center gap-3 rounded-xl border border-indigo-400/20 bg-gradient-to-br from-slate-900 via-indigo-950/40 to-slate-900 text-center">
        <span class="text-2xl font-semibold text-white">
            {title}
        </span>
                    <span class="text-xs uppercase tracking-widest text-slate-400">
            Preview Coming Soon
        </span>
                </div>
        )}
    </div>

    <!-- Project details -->
    <div class="flex flex-1 flex-col p-6 sm:p-7">

        <p class={`mb-4 w-fit rounded-full border px-3 py-1.5 text-xs font-semibold ${
            status === "completed"
                ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                : "border-amber-500/30 bg-amber-500/10 text-amber-400"
        }`}>
            {status === "completed" ? "Completed" : "In Development"}
        </p>

        <h3 class="text-2xl font-bold tracking-tight text-white">
            {title}
        </h3>

        <p class="mt-5 text-base leading-7 text-slate-400">
            {description}
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
            {technologies.map((technology) => (
                    <span class="rounded-md border border-slate-700/80 bg-slate-800/70 px-2.5 py-1 text-xs font-medium text-slate-300">
            {technology}
        </span>
            ))}
        </div>

        {(githubUrl || liveUrl) && (
                <div class="mt-auto flex flex-wrap items-center gap-6 pt-8">
            {githubUrl && (
                    <a
                            href={githubUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-400 transition-colors hover:text-indigo-300"
                    >
                        Source Code
                        <img
                                src="/icons/up-right-arrow.svg"
                                alt=""
                                aria-hidden="true"
                                class="h-4 w-4"
                        />
                    </a>
            )}

            {liveUrl && (
                    <a
                            href={liveUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-400 transition-colors hover:text-indigo-300"
                    >
                        Live Demo
                        <img
                                src="/icons/up-right-arrow.svg"
                                alt=""
                                aria-hidden="true"
                                class="h-4 w-4"
                        />
                    </a>
            )}
        </div>
        )}

    </div>
</article>